@echo off
setlocal
set "DASHBOARD_BUNDLE=%~f0"
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $self=$env:DASHBOARD_BUNDLE; $raw=[IO.File]::ReadAllText($self,[Text.Encoding]::UTF8); $marker='__DASHBOARD_PORTABLE_PAYLOAD__'; $idx=$raw.LastIndexOf($marker); if($idx -lt 0){ throw 'Payload marker not found' }; $lineEnd=$raw.IndexOf([string][char]10,$idx); if($lineEnd -lt 0){ throw 'Payload body not found' }; $ps=$raw.Substring($lineEnd+1); Invoke-Expression $ps"
set "DASHBOARD_EXIT=%ERRORLEVEL%"
echo.
if "%DASHBOARD_EXIT%"=="0" (
  echo Dashboard launcher finished. If the browser opened, the local server is already running.
  echo Press any key to close this launcher window.
  pause >nul
) else (
  echo Dashboard startup failed. Press any key to close this window.
  pause >nul
)
exit /b %DASHBOARD_EXIT%
__DASHBOARD_PORTABLE_PAYLOAD__
$ErrorActionPreference = "Stop"
$bundleRoot = Join-Path $env:TEMP "sector-flow-dashboard-portable"
New-Item -ItemType Directory -Path $bundleRoot -Force | Out-Null
