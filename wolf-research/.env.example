# Required server-side infrastructure
DATABASE_URL=postgresql://wolf_research:change-me@127.0.0.1:5432/wolf_research
WOLF_RESEARCH_MARKET_DATA_URL=http://127.0.0.1:8001

# Fixed first-release facades
WOLF_RESEARCH_AUTH_MODE=disabled
WOLF_RESEARCH_QUOTA_MODE=disabled
WOLF_RESEARCH_MEMORY_MODE=disabled
WOLF_RESEARCH_KNOWLEDGE_MODE=disabled

# Provider credentials are injected into the process environment; values stay blank here.
MODELPORT_API_KEY=
DEEPSEEK_API_KEY=
# Optional CLI benchmark selection. The evaluation-center Agent reviewer uses
# the registered official-direct profile explicitly.
WOLF_RESEARCH_EVAL_MODEL=
WOLF_RESEARCH_LLM_AGENT_ENABLED=1
WOLF_RESEARCH_LLM_QUERY_REWRITE_ENABLED=1
WOLF_RESEARCH_QUERY_REWRITE_LLM_TIMEOUT_MS=15000
WOLF_RESEARCH_QUERY_REWRITE_LLM_MAX_RETRIES=0
# Official DeepSeek defaults to 0 so hidden reasoning cannot consume the
# bounded multi-turn Agent output budget. Set 1 only for an explicit experiment.
PI_AGENT_REASONING=0

# Generated projects execute directly on trusted Windows hosts when enabled.
# This is not a sandbox. Keep disabled unless you accept that risk locally.
WOLF_RESEARCH_ALLOW_UNSANDBOXED_GENERATED_CODE=0

# Production/strict local UI mutations stay disabled unless explicitly enabled.
# Only use with the Next.js server bound to 127.0.0.1/localhost. An admin token,
# when configured, remains mandatory and takes precedence over this switch.
WOLF_RESEARCH_ALLOW_LOOPBACK_MUTATIONS=0

# Optional transport and runtime settings
WOLF_RESEARCH_SECURITY_HSTS=0
WOLF_RESEARCH_PROJECTS_DIR=./data/projects
WOLF_RESEARCH_REPORTS_DIR=./data/eval-reports
