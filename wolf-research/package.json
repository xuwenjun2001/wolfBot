{
  "name": "wolf-research",
  "version": "0.1.0",
  "description": "Wolf Research local research workbench and evaluation platform",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:checked": "npm run preflight && next start",
    "worker:generation": "tsx scripts/workers/generation-worker.ts",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run",
    "package:skills": "node scripts/skills/package-skills.js",
    "check:skills": "node scripts/checks/check-skills-registry.js && node scripts/checks/check-skill-scripts.js",
    "check:eval-datasets": "node scripts/checks/check-eval-datasets.js",
    "check:eval-judge-calibration": "node scripts/checks/check-eval-judge-calibration.js",
    "check:eval-mutations": "node scripts/checks/check-eval-mutations.js",
    "check:module-boundaries": "node scripts/checks/check-module-boundaries.js",
    "check:ai-provider-boundary": "node scripts/checks/check-ai-provider-boundary.js",
    "preflight": "tsx scripts/dev/preflight.ts",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "benchmark:quant:contract": "node scripts/evals/run-quant-benchmarks.js --mode contract",
    "benchmark:quant:e2e": "node scripts/evals/run-quant-benchmarks.js --mode e2e",
    "market:test": "uv run --project services/market-data pytest -q services/market-data/tests",
    "market:dev": "uv run --project services/market-data wolf-research-market-api"
  },
  "dependencies": {
    "@next/env": "16.2.12",
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "jiti": "2.6.1",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "12.40.0",
    "js-yaml": "4.3.0",
    "lucide-react": "1.16.0",
    "next": "16.2.12",
    "postcss": "8.5.18",
    "react": "19.2.6",
    "react-icons": "5.6.0",
    "react-dom": "19.2.6",
    "recharts": "3.8.1",
    "tailwind-merge": "3.6.0",
    "tar": "7.5.22",
    "tsconfig-paths": "3.15.0",
    "typescript": "6.0.3",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.19.19",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "autoprefixer": "10.5.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "1.60.0",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.0.0"
  }
}
