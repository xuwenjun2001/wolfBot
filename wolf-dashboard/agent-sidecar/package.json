{
  "name": "@wolfbot/agent-sidecar",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "description": "WolfBot's local PI Agent execution sidecar.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "vitest run",
    "smoke:provider": "node scripts/smoke-provider.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
