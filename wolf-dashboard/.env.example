# Copy this file to .env. Keep the real file local; it is ignored by git.
# Do not put cookies, API keys, or other credentials in this tracked example.

# Existing monitor/NGA settings
NGA_COOKIE=
NGA_BASE_URL=https://ngabbs.com
NGA_TID=47288722
NGA_AUTHOR_ID=150058
NGA_INITIAL_PAGE=29
CRAWL_INTERVAL_MINUTES=5

# OpenAI-compatible provider. Leave the key empty to record an explicit
# needs_configuration result instead of inventing an AI answer.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_EFFORT=
# AI-only request timeout in seconds; accepted range is 1..1200.
OPENAI_REQUEST_TIMEOUT=120
AI_ENABLED=true

# FastAPI -> local TypeScript PI Agent sidecar. The sidecar itself binds to
# 127.0.0.1:8790; this URL is the backend's internal client endpoint.
WOLFBOT_SIDECAR_URL=http://127.0.0.1:8790

# Agent run limits. These values are bounded by the backend/sidecar contract;
# do not use them to enable arbitrary tools or network access.
AGENT_MAX_TURNS=8
AGENT_MAX_TOTAL_TOOL_CALLS=20
AGENT_MAX_MARKET_REQUESTS=16
AGENT_MAX_OUTPUT_TOKENS=12000
AGENT_TIMEOUT_SECONDS=300

# Local persistence and scheduler
WOLF_DATABASE=./data/wolf.sqlite3
SCHEDULER_ENABLED=true
REQUEST_TIMEOUT=20
